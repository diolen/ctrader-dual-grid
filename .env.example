# cTrader Market Screener — Multi-Setup Scanner & Trading Layer
# Copy to .env and fill in your values

# ==============================================================================
# cTrader OpenAPI Connection
# ==============================================================================
# Connection parameters for cTrader Open API (demo or live)
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
ACCESS_TOKEN=your_access_token
ACCOUNT_ID=your_account_id

# ==============================================================================
# Trading Instruments
# ==============================================================================
# List of trading pairs (comma-separated)
PAIRS=EURUSD
# Override pair-specific parameters: {PAIR}_BREAKOUT_MIN_DISPLACEMENT_PIPS=4.0

# ==============================================================================
# Strategy Selection
# ==============================================================================
# Available strategies: BREAKOUT_RETEST_V3, DUAL_GRID_V8
# BREAKOUT_RETEST_V3 - Multi-setup scanner (Breakout, Pullback, Liquidity Sweep, Price Action)
# DUAL_GRID_V8 - Adaptive Dual Grid Portfolio Strategy with risk management
STRATEGY_TYPE=DUAL_GRID_V8

# ==============================================================================
# Screener Configuration (SCREENER_ONLY=true)
# ==============================================================================
# Run in screener-only mode (no trading)
SCREENER_ONLY=false
# Use multi-setup scanner pipeline (4 scanners in parallel)
USE_MULTI_SCANNER=true
# Enable warmup cache to avoid re-downloading candles on reconnect
WARMUP_CACHE_ENABLED=true
# Poll delay between pairs (0 = auto: 0.4s ≤12 pairs, 0.6s ≤16, 0.8s >16)
PAIR_POLL_DELAY_SEC=0
# API metrics logging interval in seconds (0 = disabled)
API_METRICS_LOG_INTERVAL_SEC=300

# ==============================================================================
# Trading Window (UTC)
# ==============================================================================
# Trading window start time (UTC)
TRADE_WINDOW_START=00:00
# Trading window end time (UTC)
TRADE_WINDOW_END=23:59

# ==============================================================================
# Trading Configuration (SCREENER_ONLY=false)
# ==============================================================================
# Trading mode: MANUAL (log signals only) or AUTO (execute orders)
TRADING_MODE=AUTO
# Maximum lot size per order
MAX_LOT=0.3
# Enable trailing stop loss
TRAILING_STOP_LOSS=false
# Maximum age of pending orders in seconds
PENDING_ORDER_MAX_AGE_SECONDS=900
# Interval for cleaning up stale pending orders (seconds)
PENDING_ORDER_CLEANUP_INTERVAL_SECONDS=30
# Minimum interval between breakout orders (seconds)
BREAKOUT_MIN_ORDER_INTERVAL_SECONDS=0.0

# ==============================================================================
# Trading Layer (DUAL_GRID_V8)
# ==============================================================================
# Entry and level thresholds
ENTRY_THRESHOLD=0.7
ADD_LEVEL_THRESHOLD=0.6

# ATR parameters
ATR_PERIOD=14
ATR_MULTIPLIER=1.5

# Grid limits
MAX_GRID_LEVELS=5

# Portfolio risk management
MAX_PORTFOLIO_DRAWDOWN=-0.10
PORTFOLIO_TARGET=0.15
MAX_TOTAL_EXPOSURE=0.50

# Position sizing
RISK_PER_TRADE=0.02
SL_ATR_MULTIPLIER=2.0

# Execution checks - spread
SPREAD_LOOKBACK_BARS=20
SPREAD_REJECT_MULTIPLIER=2.0
SPREAD_WARN_MULTIPLIER=1.5

# Execution checks - ATR
ATR_BASELINE_LOOKBACK_BARS=50
ATR_SPIKE_MULTIPLIER=2.0
EXECUTION_WARN_VOLUME_REDUCTION=0.5

# Imbalance control
IMBALANCE_SOFT_THRESHOLD=0.6
IMBALANCE_HARD_THRESHOLD=0.8
IMBALANCE_SCORE_PENALTY=0.1

# Degradation modes
EXIT_MODE_DRAWDOWN_THRESHOLD=-0.05
FREEZE_ATR_SPIKE_MULTIPLIER=3.0
FREEZE_CONSECUTIVE_REJECTIONS=5
CONSERVATIVE_SCORE_PENALTY=0.15
CONSERVATIVE_VOLUME_MULTIPLIER=0.7
CONSECUTIVE_REJECTIONS_FOR_CONSERVATIVE=3

# Grid order TTL
GRID_ORDER_TTL_BARS=3

# Watched instruments (format: SYMBOL:TIMEFRAME,SYMBOL:TIMEFRAME)
WATCHED_INSTRUMENTS=EURUSD:M5

# ==============================================================================
# Debugging
# ==============================================================================
# Log strategy debug info every N bars (0 = auto)
STRATEGY_DEBUG_EVERY_N=0

# ==============================================================================
# Backtest Configuration (python main.py --backtest)
# ==============================================================================
# Number of M5 bars to backtest per pair
BACKTEST_BARS=26000
# Warmup bars before backtest starts
BACKTEST_WARMUP_BARS=500
# Assumed spread in pips for backtest
BACKTEST_ASSUMED_SPREAD_PIPS=1.5
# Quiet logs in backtest mode
BACKTEST_QUIET_LOGS=true

# Optimized parameters for EURUSD
# Generated: 2026-06-23 01:46:37 UTC
# Timeframe: M5 | Trail: 6.0 pips
# Tested 50 combinations | 50 valid (min_trades>=10)
# Best -> Total R: +9.9R | Winrate: 66.7% | PF: 2.10 | Trades: 27
#
EURUSD_BREAKOUT_MIN_DISPLACEMENT_PIPS=9.0
EURUSD_BREAKOUT_MAX_DISPLACEMENT_PIPS=45.0
EURUSD_BREAKOUT_LEVEL_LOOKBACK_BARS=60.0
EURUSD_BREAKOUT_RETEST_TIMEOUT_BARS=25.0

