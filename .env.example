# cTrader Market Screener — Multi-Setup Scanner
# Copy to .env and fill in your values

# --- cTrader OpenAPI ---
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
ACCESS_TOKEN=your_access_token
ACCOUNT_ID=your_account_id

# --- Пары (defaults и overrides: app/config/settings.py) ---
PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,XAUUSD,BTCUSD
# Переопределение пары: {PAIR}_BREAKOUT_MIN_DISPLACEMENT_PIPS=4.0

# --- Screener (SCREENER_ONLY=true) ---
SCREENER_ONLY=true
USE_MULTI_SCANNER=true
WARMUP_CACHE_ENABLED=true
# PAIR_POLL_DELAY_SEC=0          # 0 = auto (0.4s ≤12 pairs, 0.6s ≤16, 0.8s >16)
# API_METRICS: футер дашборда + периодический лог; 0 = выкл
API_METRICS_LOG_INTERVAL_SEC=300

# --- Стратегия / окно анализа (UTC) ---
STRATEGY_TYPE=BREAKOUT_RETEST_V3
TRADE_WINDOW_START=00:00
TRADE_WINDOW_END=23:59

# --- Торговля (только при SCREENER_ONLY=false) ---
TRADING_MODE=MANUAL
MAX_LOT=1.0
TRAILING_STOP_LOSS=true
PENDING_ORDER_MAX_AGE_SECONDS=900
PENDING_ORDER_CLEANUP_INTERVAL_SECONDS=30
BREAKOUT_MIN_ORDER_INTERVAL_SECONDS=0.0

# --- Отладка ---
STRATEGY_DEBUG_EVERY_N=0

# --- Бэктest (python main.py --backtest) ---
BACKTEST_BARS=26000
BACKTEST_WARMUP_BARS=500
BACKTEST_ASSUMED_SPREAD_PIPS=1.5
BACKTEST_QUIET_LOGS=true
