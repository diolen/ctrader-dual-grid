# Generated: 2026-06-23 01:45:19 UTC
# Timeframe: M5 | Trail: 10.0 pips
# Tested 50 combinations | 50 valid (min_trades>=10)
# Best -> Total R: +7.9R | Winrate: 50.0% | PF: 1.26 | Trades: 62
#
GBPUSD_BREAKOUT_MIN_DISPLACEMENT_PIPS=3.0
GBPUSD_BREAKOUT_MAX_DISPLACEMENT_PIPS=35.0
GBPUSD_BREAKOUT_LEVEL_LOOKBACK_BARS=50.0
GBPUSD_BREAKOUT_RETEST_TIMEOUT_BARS=25.0

# Optimized parameters for XAUUSD
# Generated: 2026-06-23 01:43:51 UTC
# Timeframe: M5 | Trail: 40.0 pips
# Tested 50 combinations | 6 valid (min_trades>=5)
# Best -> Total R: +6.2R | Winrate: 100.0% | PF: inf | Trades: 10
#
XAUUSD_BREAKOUT_MIN_DISPLACEMENT_PIPS=20.0
XAUUSD_BREAKOUT_MAX_DISPLACEMENT_PIPS=500.0
XAUUSD_BREAKOUT_LEVEL_LOOKBACK_BARS=90.0
XAUUSD_BREAKOUT_RETEST_TIMEOUT_BARS=10.0
XAUUSD_BREAKOUT_MAX_RETRACE_PERCENT=95.0
XAUUSD_BREAKOUT_RETEST_TOLERANCE_PIPS=25.0

# Optimized parameters for BTCUSD
# Generated: 2026-06-23 01:42:28 UTC
# Timeframe: M5 | Trail: 120.0 pips
# Tested 50 combinations | 45 valid (min_trades>=5)
# Best -> Total R: +25.4R | Winrate: 70.2% | PF: 1.40 | Trades: 215
#
BTCUSD_BREAKOUT_MIN_DISPLACEMENT_PIPS=80.0
BTCUSD_BREAKOUT_MAX_DISPLACEMENT_PIPS=1400.0
BTCUSD_BREAKOUT_LEVEL_LOOKBACK_BARS=50.0
BTCUSD_BREAKOUT_RETEST_TIMEOUT_BARS=10.0
BTCUSD_BREAKOUT_MAX_RETRACE_PERCENT=95.0
BTCUSD_BREAKOUT_RETEST_TOLERANCE_PIPS=90.0